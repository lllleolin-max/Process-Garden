{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Process Garden",
  "version": "0.1.0",
  "identifier": "garden.process.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Process Garden",
        "width": 1440,
        "height": 960,
        "minWidth": 1040,
        "minHeight": 720,
        "decorations": true,
        "transparent": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Your computer is alive.",
    "longDescription": "Process Garden turns local process activity into a living digital ecosystem.",
    "category": "Utility",
    "resources": ["../LICENSE", "../THIRD_PARTY_NOTICES.md", "../licenses/OFL-1.1.txt", "../docs/fonts.md"]
  }
}
